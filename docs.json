{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "TryMCP",
  "colors": {
    "primary": "#D9631C",
    "light": "#EE8143",
    "dark": "#D9631C"
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "https://trymcp.io"
  },
  "favicon": "/favicon.svg",
  "navbar": {
    "primary": {
      "type": "button",
      "label": "Open TryMCP",
      "href": "https://app.trymcp.io"
    }
  },
  "navigation": {
    "groups": [
      {
        "group": "Start here",
        "pages": ["index", "quickstart"]
      },
      {
        "group": "Build",
        "pages": ["servers", "security", "tools", "runtime", "secrets", "examples"]
      },
      {
        "group": "Check",
        "pages": ["logs-and-analytics"]
      },
      {
        "group": "Connect",
        "pages": ["connect/claude-desktop", "connect/cursor-and-vscode", "connect/windsurf-and-cline"]
      }
    ],
    "global": {
      "anchors": [
        {"anchor": "Dashboard", "href": "https://app.trymcp.io", "icon": "gauge"},
        {"anchor": "Website", "href": "https://trymcp.io", "icon": "globe"}
      ]
    }
  },
  "footer": {
    "socials": {
      "x": "https://x.com/trymcp",
      "linkedin": "https://www.linkedin.com/company/trymcp",
      "instagram": "https://instagram.com/trymcp"
    }
  },
  "background": {
    "color": {"light": "#F3F4F0", "dark": "#131410"}
  },
  "appearance": {"default": "system"}
}
